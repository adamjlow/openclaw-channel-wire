# Copy to test/docker/.env (gitignored). Generate the WIRE_SDK_* block with
# node scripts/register-app.mjs create ... --out test/docker/.env (see README).

# Wire app (from register-app.mjs create --out test/docker/.env)
WIRE_SDK_API_HOST=https://prod-nginz-https.wire.com
WIRE_SDK_APP_ID=
WIRE_SDK_APP_DOMAIN=
WIRE_SDK_API_TOKEN=
WIRE_SDK_CRYPTO_KEY=

# Access policy. Qualified Wire user ids, comma separated: <uuid>@<domain>
WIRE_DM_POLICY=pairing
WIRE_ALLOW_FROM=
WIRE_GROUP_POLICY=allowlist
WIRE_GROUP_ALLOW_FROM=
WIRE_REQUIRE_MENTION=true

# Gateway auth token (any long random string, e.g. `openssl rand -hex 24`)
OPENCLAW_GATEWAY_TOKEN=

# Model provider, applied on first run only. Pick an onboard --auth-choice and
# set the matching key variable, e.g. openai-api-key + OPENAI_API_KEY.
OPENCLAW_AUTH_CHOICE=skip
# OPENAI_API_KEY=
